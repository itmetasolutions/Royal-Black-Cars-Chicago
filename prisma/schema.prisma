// CMS Phase 1: authentication + site settings.
// Pages/blog content models are added in later phases.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model AdminUser {
  id        String    @id @default(cuid())
  email     String    @unique
  name      String?
  role      String    @default("admin") // "admin" | "editor"
  createdAt DateTime  @default(now())
  lastLogin DateTime?
  otpCodes  OtpCode[]

  @@map("admin_users")
}

model OtpCode {
  id         String    @id @default(cuid())
  userId     String
  user       AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash   String
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now())

  @@index([userId, createdAt])
  @@map("otp_codes")
}

model SiteSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt

  @@map("site_settings")
}

// CMS Phase 2: content for the templated page types (Services, Airports,
// Fleet) and the fixed set of core pages. `data`/`fields` hold the
// template-specific content as JSON so one model can serve every type in
// its group without a rigid column per field.
model TemplatePage {
  id     String @id @default(cuid())
  type   String // "service" | "airport" | "fleet"
  slug   String
  title  String
  data   Json

  metaTitle         String?
  metaDescription   String?
  focusKeyword      String?
  secondaryKeywords String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([type, slug])
  @@index([type])
  @@map("template_pages")
}

model CorePage {
  id     String @id @default(cuid())
  key    String @unique // "home" | "about" | "contact" | "faq" | "rates" | "corporate-accounts" | "terms" | "privacy"
  title  String
  fields Json

  metaTitle         String?
  metaDescription   String?
  focusKeyword      String?
  secondaryKeywords String?

  updatedAt DateTime @updatedAt

  @@map("core_pages")
}

// CMS Phase 3: blog. contentHtml is rich text from the admin's editor,
// rendered as-is on the public post page — safe because only authenticated
// admins can write it, never public/user input.
model BlogPost {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  excerpt     String
  contentHtml String
  img         String?
  status      String   @default("published") // "draft" | "published"
  publishedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  metaTitle         String?
  metaDescription   String?
  focusKeyword      String?
  secondaryKeywords String?

  @@map("blog_posts")
}
