# Postgres (Vercel Storage → Marketplace → Neon, connected to this project auto-fills these).
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Resend — https://resend.com — API key + a "from" address on a domain you've verified there.
RESEND_API_KEY=
RESEND_FROM_EMAIL=admin@yourdomain.com

# Random string, 32+ characters, used to sign admin session cookies.
# Generate one with: openssl rand -base64 32
SESSION_SECRET=

# Comma-separated emails allowed to log into /admin the first time
# (each becomes an admin_users row on first successful login request).
ADMIN_EMAILS=you@example.com

# Media library (Vercel dashboard → Storage → create a Blob store, connect
# it to this project — these are auto-filled, not secrets). @vercel/blob
# authenticates via BLOB_STORE_ID + Vercel's own runtime OIDC token, so
# this only works once deployed; leave blank locally unless you also add
# a classic BLOB_READ_WRITE_TOKEN for local testing.
BLOB_STORE_ID=
BLOB_WEBHOOK_PUBLIC_KEY=
